SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_reports,read_themes
APP_URL=
ANALYTICS_SERVICE_URL=http://localhost:4000/api/analytics/ingest
PORT=3000

# Path to the SQLite file. In production this MUST point at a mounted
# persistent volume (e.g. /data/shops.db on Railway) or every redeploy wipes
# installed shops. Leave unset for local dev — defaults to ./shops.db.
DB_PATH=

# 32-byte key (hex or base64) used to encrypt access/refresh tokens at rest
# in shops.db. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; if unset, tokens are stored in plaintext (dev only).
ENCRYPTION_KEY=
